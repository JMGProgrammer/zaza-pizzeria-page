---
import { getImage } from "astro:assets";
import socialPoster from "../../Assets/Presentation/capresse-luxury-presentation.jpeg";
import "../styles/global.css";
import "../styles/fonts.css";
import { businessInfo } from "../data/businessInfo";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const socialImage = await getImage({
  src: socialPoster,
  width: 900,
  format: "jpeg",
});

const {
  title = `${businessInfo.name} Pizzería Artesanal | Delivery en Rosario, Colonia`,
  description = `${businessInfo.name} en Rosario, Colonia. ${businessInfo.tagline} Pizzas clásicas y especiales de masa casera. Pedí tu delivery directo al WhatsApp.`,
  ogImage = socialImage.src,
} = Astro.props;

const siteUrl = Astro.site?.href;
const socialImageUrl = siteUrl ? new URL(ogImage, siteUrl).href : ogImage;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: `${businessInfo.name} Pizzería`,
  description: businessInfo.tagline,
  servesCuisine: "Pizza artesanal",
  telephone: businessInfo.contact.phone,
  url: siteUrl,
  address: {
    "@type": "PostalAddress",
    addressLocality: businessInfo.location.city,
    addressRegion: businessInfo.location.department,
    addressCountry: "UY",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: businessInfo.schedule.opens,
      closes: businessInfo.schedule.closes,
    },
  ],
  paymentAccepted: businessInfo.delivery.paymentMethods.join(", "),
  priceRange: "$$",
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link
      rel="preload"
      href="/fonts/cormorant-garamond-600-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/playfair-display-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Metadatos SEO Primarios -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#5a131a" />
    {siteUrl && <link rel="canonical" href={siteUrl} />}

    <!-- Open Graph / Facebook / WhatsApp Preview -->
    <meta property="og:type" content="website" />
    {siteUrl && <meta property="og:url" content={siteUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content={businessInfo.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <!-- Schema.org JSON-LD para SEO Gastronómico Local -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="min-h-screen bg-zaza-cream-100 text-zaza-dark antialiased selection:bg-zaza-wine-700 selection:text-zaza-cream-50 flex flex-col">
    <slot />
  </body>
</html>
