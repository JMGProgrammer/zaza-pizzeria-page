---
import Layout from '../layouts/Layout.astro';
import { Flame, Clock, MapPin, Sparkles } from 'lucide-astro';
---

<Layout>
  <main class="min-h-screen flex flex-col justify-center items-center px-4 py-12">
    <div class="max-w-2xl w-full bg-zaza-cream-50 border border-zaza-cream-200 rounded-2xl p-8 shadow-xl text-center space-y-6">
      
      <!-- Badge de Estado -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zaza-wine-900/10 text-zaza-wine-700 text-sm font-semibold">
        <Sparkles class="w-4 h-4 text-zaza-gold-500" />
        <span>Iteración 1: Entorno de Desarrollo Activo</span>
      </div>

      <!-- Título de Marca con Tipografía Playfair Display -->
      <h1 class="text-4xl sm:text-5xl font-extrabold text-zaza-wine-800 tracking-tight">
        ZAZA Pizzería
      </h1>

      <p class="text-lg text-zaza-muted italic">
        "Hecho con pasión, buenos ingredientes, sabor auténtico."
      </p>

      <!-- Indicadores de tokens del Design System -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-zaza-cream-200 text-left">
        <div class="p-4 rounded-xl bg-zaza-cream-100 border border-zaza-cream-200">
          <div class="flex items-center gap-2 text-zaza-wine-700 font-semibold mb-1">
            <Flame class="w-5 h-5" />
            <span>Masa Casera</span>
          </div>
          <p class="text-xs text-zaza-muted">Cultura pizzera mixta y recetas artesanales.</p>
        </div>

        <div class="p-4 rounded-xl bg-zaza-cream-100 border border-zaza-cream-200">
          <div class="flex items-center gap-2 text-zaza-wine-700 font-semibold mb-1">
            <Clock class="w-5 h-5" />
            <span>20:00 a 01:00 hs</span>
          </div>
          <p class="text-xs text-zaza-muted">Lunes a Domingo (todos los días).</p>
        </div>

        <div class="p-4 rounded-xl bg-zaza-cream-100 border border-zaza-cream-200">
          <div class="flex items-center gap-2 text-zaza-wine-700 font-semibold mb-1">
            <MapPin class="w-5 h-5" />
            <span>100% Delivery</span>
          </div>
          <p class="text-xs text-zaza-muted">Cobertura en todo Rosario, Colonia.</p>
        </div>
      </div>

      <!-- Botones de muestra con tokens de Tailwind -->
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <span class="px-5 py-2.5 rounded-xl bg-zaza-wine-700 text-zaza-cream-50 font-medium shadow-md">
          Color Vino ZAZA
        </span>
        <span class="px-5 py-2.5 rounded-xl bg-zaza-gold-500 text-zaza-cream-50 font-medium shadow-md">
          Acento Oro
        </span>
        <span class="px-5 py-2.5 rounded-xl bg-zaza-cream-200 text-zaza-dark font-medium border border-zaza-cream-300">
          Crema Cálido
        </span>
      </div>

    </div>
  </main>
</Layout>
