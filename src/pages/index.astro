---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import { businessInfo } from '../data/businessInfo';
import { menuItems } from '../data/menu';
import { MessageCircle, Clock, MapPin, CreditCard } from 'lucide-astro';

const featuredPizzas = menuItems.filter(item => item.isFeatured);
---

<Layout>
  <!-- Barra de navegación con logo y acceso a WhatsApp -->
  <Navbar />

  <!-- Sección Hero impactante -->
  <Hero />

  <main class="flex-grow">
    <!-- Sección de Pizzas Destacadas (Preview rápido) -->
    <section id="destacadas" class="py-16 bg-zaza-cream-50 border-b border-zaza-cream-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-zaza-wine-700">Selección del Maestro</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-zaza-wine-900 font-serif mt-1">
            Nuestras Especialidades
          </h2>
          <p class="text-zaza-muted mt-3">
            Elaboradas al momento con masa de receta propia e ingredientes de primera calidad.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredPizzas.map((pizza) => (
            <div class="bg-zaza-cream-100 rounded-2xl border border-zaza-cream-200 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
              <div>
                {pizza.image ? (
                  <div class="relative h-48 overflow-hidden bg-zaza-wine-900">
                    <img 
                      src={pizza.image} 
                      alt={`Pizza ${pizza.name} de ZAZA`} 
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    {pizza.badge && (
                      <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-zaza-wine-900/90 text-zaza-gold-400 text-xs font-bold uppercase tracking-wider backdrop-blur-sm border border-zaza-gold-500/30">
                        {pizza.badge}
                      </span>
                    )}
                  </div>
                ) : (
                  <div class="relative h-48 bg-gradient-to-br from-zaza-wine-800 to-zaza-wine-950 flex items-center justify-center p-6 text-center">
                    <span class="font-serif text-2xl font-bold text-zaza-cream-100">{pizza.name}</span>
                    {pizza.badge && (
                      <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-zaza-wine-900/90 text-zaza-gold-400 text-xs font-bold uppercase tracking-wider border border-zaza-gold-500/30">
                        {pizza.badge}
                      </span>
                    )}
                  </div>
                )}
                <div class="p-5">
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="font-serif text-xl font-bold text-zaza-wine-900">{pizza.name}</h3>
                    <span class="font-extrabold text-zaza-wine-700 text-lg">$ {pizza.price}</span>
                  </div>
                  <p class="text-sm text-zaza-muted line-clamp-2 leading-relaxed">
                    {pizza.description}
                  </p>
                </div>
              </div>

              <div class="p-5 pt-0">
                <a
                  href={`${businessInfo.contact.whatsappUrl}?text=${encodeURIComponent(`¡Hola ZAZA! Quisiera pedir una pizza ${pizza.name}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-zaza-wine-700 hover:bg-zaza-wine-600 text-zaza-cream-50 text-sm font-semibold transition-colors"
                >
                  <MessageCircle class="w-4 h-4" />
                  <span>Pedir Esta Pizza</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sección de Información de Delivery y Medios de Pago -->
    <section id="delivery" class="py-16 bg-zaza-cream-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-zaza-wine-900 text-zaza-cream-100 rounded-3xl p-8 sm:p-12 shadow-2xl relative overflow-hidden border border-zaza-wine-700">
          <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="space-y-3">
              <div class="w-12 h-12 rounded-2xl bg-zaza-wine-800 flex items-center justify-center text-zaza-gold-400 border border-zaza-gold-500/30">
                <Clock class="w-6 h-6" />
              </div>
              <h3 class="text-xl font-serif font-bold text-zaza-cream-50">Horario de Cocina</h3>
              <p class="text-sm text-zaza-cream-200">
                {businessInfo.schedule.hours} <br />
                <span class="text-zaza-gold-400 font-semibold">{businessInfo.schedule.days}</span>
              </p>
            </div>

            <div class="space-y-3">
              <div class="w-12 h-12 rounded-2xl bg-zaza-wine-800 flex items-center justify-center text-zaza-gold-400 border border-zaza-gold-500/30">
                <MapPin class="w-6 h-6" />
              </div>
              <h3 class="text-xl font-serif font-bold text-zaza-cream-50">Zona de Entrega</h3>
              <p class="text-sm text-zaza-cream-200">
                {businessInfo.delivery.coverage}. <br />
                <span class="text-xs text-zaza-cream-300 italic">{businessInfo.location.policy}</span>
              </p>
            </div>

            <div class="space-y-3">
              <div class="w-12 h-12 rounded-2xl bg-zaza-wine-800 flex items-center justify-center text-zaza-gold-400 border border-zaza-gold-500/30">
                <CreditCard class="w-6 h-6" />
              </div>
              <h3 class="text-xl font-serif font-bold text-zaza-cream-50">Medios de Pago</h3>
              <p class="text-sm text-zaza-cream-200">
                {businessInfo.delivery.paymentMethods.join(" • ")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Pie de página simple para IT2 -->
  <footer class="bg-zaza-wine-950 text-zaza-cream-300 py-8 border-t border-zaza-wine-800 text-center text-xs space-y-2">
    <p class="font-serif text-base text-zaza-cream-100 font-bold tracking-wider">{businessInfo.name} Pizzería</p>
    <p>{businessInfo.location.city}, {businessInfo.location.department}, {businessInfo.location.country} • {businessInfo.schedule.hours}</p>
    <p class="text-zaza-cream-400/60">© {new Date().getFullYear()} ZAZA. Todos los derechos reservados.</p>
  </footer>
</Layout>
