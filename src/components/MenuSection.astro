---
import { Image, getImage } from 'astro:assets';
import { menuItems, categoriesMap } from '../data/menu';
import { whatsappLink } from '../data/businessInfo';
import PizzaCard from './PizzaCard.astro';
import patronBg from '../../Assets/Backgrounds/bodreaux-patron-bg.jpeg';
import cartaEnmarcada from '../../Assets/Pngs/cartas/carta-enmarcada.png';
import { ArrowUpRight } from 'lucide-astro';

const optimizedPatron = await getImage({
  src: patronBg,
  width: 2048,
  quality: 80,
  format: 'webp',
});
---

<!-- Sección de Especialidades / Destacadas -->
<section id="destacadas" class="bg-zaza-cream-100 px-6 py-16 md:py-24">
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow text-zaza-wine-700">De nuestra cocina</p>
    <h2 class="mt-3 text-4xl text-zaza-wine-800 md:text-5xl">La pizza tiene su momento.</h2>
    <p class="mt-4 text-zaza-muted">Elegí tu favorita. Del resto, hablamos por WhatsApp.</p>
    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {menuItems.filter(item => item.image).map(item => <PizzaCard item={item} />)}
    </div>
  </div>
</section>

<!-- Sección de la Carta con Fondo Damasco Bordeaux y Carta Enmarcada -->
<section
  id="menu"
  class="menu-patron-section relative px-6 py-20 text-zaza-cream-100 md:py-28"
  style={`background-image: radial-gradient(ellipse at center, rgba(61, 12, 17, 0.42) 0%, rgba(20, 4, 6, 0.92) 100%), url('${optimizedPatron.src}');`}
>
  <div class="mx-auto max-w-4xl text-center">
    <p class="eyebrow text-zaza-cream-300">Tradición y sabor artesanal</p>
    <h2 class="mt-3 text-4xl leading-tight text-zaza-cream-100 md:text-5xl">Nuestra carta</h2>
    <p class="mx-auto mt-4 max-w-lg text-sm leading-6 text-zaza-cream-200">
      Masa artesanal y casera, salsa de tomate y los mejores ingredientes. Precios en pesos uruguayos (UYU).
    </p>

    <!-- Marco de madera con la carta oficial ZAZA -->
    <div class="mx-auto mt-12 max-w-xl">
      <div class="framed-carta-container">
        <Image
          src={cartaEnmarcada}
          alt="Carta oficial de ZAZA Pizzería enmarcada en madera tallada: Pizzas clásicas, pizzas especiales, para acompañar y bebidas"
          widths={[500, 750, 1000, 1472]}
          sizes="(max-width: 640px) 95vw, 620px"
          quality={92}
          class="framed-carta-image"
          loading="lazy"
        />
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          class="button bg-zaza-cream-100 text-zaza-wine-800 hover:bg-zaza-cream-200 shadow-2xl"
          href={whatsappLink('¡Hola ZAZA! Me gustaría consultar por el menú / hacer un pedido.')}
          target="_blank"
          rel="noopener noreferrer"
        >
          Pedir por WhatsApp <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- Contenido semántico para lectores de pantalla y buscadores (SEO) -->
    <div class="sr-only" aria-label="Detalle accesible de productos y precios de la carta">
      {categoriesMap.map(category => (
        <div>
          <h3>{category.label}</h3>
          <ul>
            {menuItems.filter(item => item.category === category.id).map(item => (
              <li>
                <strong>{item.name}</strong> - $ {item.price} UYU.
                {item.description && <span> {item.description}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .menu-patron-section {
    background-color: var(--color-zaza-wine-900, #3d0c11);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-top: 1px solid rgba(228, 213, 183, 0.2);
    border-bottom: 1px solid rgba(228, 213, 183, 0.2);
  }

  .framed-carta-container {
    position: relative;
    border-radius: 8px;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.85)) drop-shadow(0 6px 16px rgba(61, 12, 17, 0.7));
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .framed-carta-container:hover {
    transform: translateY(-4px) scale(1.01);
  }

  .framed-carta-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
  }
</style>
