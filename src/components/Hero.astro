---
import { Image } from "astro:assets";
import facade from "../../Assets/hero-section-reworked.jpeg";
import sign from "../../Assets/Pizarron hero/pizarron-escrito-recortado.png";
import signHover from "../../Assets/Pizarron hero/pizarron-escrito-hover-recortado.png";
---

<section
  id="inicio"
  class="storefront-hero bg-zaza-wine-900 text-zaza-cream-100"
  aria-labelledby="hero-title"
>
  <Image
    src={facade}
    alt="Representación visual de la fachada de ZAZA Pizzería"
    widths={[640, 960, 1440, 1920, 2752]}
    sizes="100vw"
    quality={82}
    class="storefront-photo"
    loading="eager"
    decoding="sync"
    fetchpriority="high"
  />
  <div class="storefront-shade" aria-hidden="true"></div>

  <div class="hero-inner mx-auto max-w-6xl px-6">
    <div class="hero-copy">
      <p class="eyebrow text-zaza-cream-200">ZAZA · Rosario, Colonia</p>
      <h1
        id="hero-title"
        class="mt-4 text-4xl leading-tight md:text-5xl lg:text-6xl"
      >
        Pizza hecha
        <br />a nuestra manera.
      </h1>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-zaza-cream-100 md:text-base">
        Masa casera. Buenos ingredientes. Solo delivery en Rosario, de 20:00 a
        01:00.
      </p>
    </div>

    <a href="#menu" class="menu-sign" aria-label="Ver la carta de ZAZA">
      <Image
        src={sign}
        alt=""
        widths={[240, 360, 520]}
        sizes="(max-width: 640px) 180px, (max-width: 1024px) 230px, 290px"
        class="sign-image sign-default"
        loading="eager"
      />
      <Image
        src={signHover}
        alt=""
        widths={[240, 360, 520]}
        sizes="(max-width: 640px) 180px, (max-width: 1024px) 230px, 290px"
        class="sign-image sign-lit"
        loading="eager"
      />
      <span class="sign-caption">
        Tocá el pizarrón para ver la carta <span aria-hidden="true">↗</span>
      </span>
    </a>
  </div>
  <p class="image-disclaimer">
    Imagen representativa · Pedidos exclusivamente por delivery
  </p>
</section>

<style>
  .storefront-hero {
    position: relative;
    isolation: isolate;
    min-height: max(720px, 100dvh);
    overflow: hidden;
  }
  /* El toldo tiene huecos transparentes: la foto sigue detrás del festón. */
  @media (min-width: 768px) {
    .storefront-hero {
      margin-top: calc(-1 * min(200px, 20.57vw));
    }
  }
  .storefront-photo,
  .storefront-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .storefront-photo {
    object-fit: cover;
    object-position: center center;
    z-index: 0;
  }
  .storefront-shade {
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(29, 12, 13, 0.86) 0%,
        rgba(29, 12, 13, 0.46) 38%,
        transparent 72%
      ),
      linear-gradient(0deg, rgba(29, 12, 13, 0.75) 0%, transparent 28%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    min-height: max(720px, 100dvh);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(min(200px, 20.57vw) + 1.5rem);
    padding-bottom: 3.5rem;
  }
  .hero-copy {
    max-width: 31rem;
    text-shadow: 0 2px 12px rgba(18, 7, 8, 0.75);
  }
  .menu-sign {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    width: clamp(180px, 23vw, 290px);
    position: relative;
    color: var(--color-zaza-cream-100);
    text-align: center;
    text-decoration: none;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sign-image {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 12px 20px rgba(16, 7, 7, 0.55));
  }
  .sign-lit {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .menu-sign:hover .sign-lit,
  .menu-sign:focus-visible .sign-lit {
    opacity: 1;
  }
  .menu-sign:hover,
  .menu-sign:focus-visible {
    transform: translateY(-5px);
  }
  .menu-sign:active {
    transform: scale(0.97);
  }
  .menu-sign:focus-visible {
    outline: 3px solid var(--color-zaza-cream-100);
    outline-offset: 5px;
  }
  .sign-caption {
    display: block;
    margin-top: -0.25rem;
    padding: 0.4rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.35;
    background: var(--color-zaza-wine-900);
  }
  .image-disclaimer {
    position: absolute;
    z-index: 2;
    bottom: 0.65rem;
    right: 1.5rem;
    font-size: 0.7rem;
    text-shadow: 0 1px 5px #1c1917;
  }
  @media (min-width: 1024px) {
    .menu-sign {
      /* Sitúa el pizarrón sobre el piso, entre el acceso y las sillas. */
      margin-left: calc(min(20vw, 400px) - 45px);
      top: 30px;
      isolation: isolate;
    }
    .menu-sign::before,
    .menu-sign::after {
      content: "";
      position: absolute;
      z-index: -1;
      width: 52px;
      height: 12px;
      border-radius: 50%;
      background: rgba(17, 7, 6, 0.72);
      filter: blur(6px);
      pointer-events: none;
    }
    .menu-sign::before {
      left: 23%;
      top: calc(100% - 36px);
    }
    .menu-sign::after {
      left: 85%;
      top: calc(100% - 56px);
    }
  }
  @media (max-width: 767px) {
    .storefront-hero {
      /* La foto también asoma por los huecos del festón en móvil. */
      margin-top: -45px;
    }
    .storefront-hero,
    .hero-inner {
      min-height: max(640px, calc(100dvh - 9rem));
    }
    .storefront-photo {
      /* Mostrar un poco más del acceso y elevar la línea del suelo bajo el pizarrón. */
      object-position: 60% center;
      transform: translateY(-18px) scale(1.06);
    }
    .storefront-shade {
      background: linear-gradient(
        180deg,
        rgba(29, 12, 13, 0.82) 0%,
        rgba(29, 12, 13, 0.25) 48%,
        rgba(29, 12, 13, 0.75) 100%
      );
    }
    .hero-inner {
      padding-top: calc(45px + 2rem);
      padding-bottom: 3rem;
    }
    .menu-sign {
      align-self: center;
    }
    .image-disclaimer {
      right: 0.75rem;
      left: 0.75rem;
      text-align: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-sign,
    .sign-lit {
      transition: none;
    }
  }
</style>
