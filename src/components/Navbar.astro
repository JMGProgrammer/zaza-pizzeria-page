---
import { Image } from "astro:assets";
import headerBackground from "../../Assets/Backgrounds/header-bg.png";
import Wordmark from "./Wordmark.astro";
import { whatsappLink } from "../data/businessInfo";
---

<header class="header-canopy sticky top-0 z-40 isolate overflow-hidden bg-zaza-wine-800 text-zaza-cream-100">
  <Image
    src={headerBackground}
    alt=""
    widths={[700, 960, 1280, 1920]}
    sizes="(max-width: 767px) 700px, max(100vw, 960px)"
    class="header-canopy-image"
    aria-hidden="true"
    loading="eager"
  />
  <div class="relative z-10 mx-auto flex min-h-24 max-w-6xl items-center justify-between px-6 pr-24 sm:pr-32 md:pr-36">
    <Wordmark />
    <nav aria-label="Navegación principal" class="hidden gap-7 text-sm md:flex">
      <a href="#menu">Menú</a>
      <a href="#destacadas">Especialidades</a>
      <a href="#delivery">Delivery &amp; Pagos</a>
      <a href="#nosotros">Nuestra Masa</a>
    </nav>
    <a
      class="button border border-zaza-cream-300/60 text-sm hover:bg-zaza-wine-700"
      href={whatsappLink()}
      target="_blank"
      rel="noopener noreferrer"
    >
      Hacer pedido ↗
    </a>
  </div>
  <nav
    aria-label="Navegación móvil"
    class="relative z-10 flex justify-center gap-5 border-t border-zaza-cream-300/20 px-3 py-3 pr-20 text-xs md:hidden"
  >
    <a href="#menu">Menú</a>
    <a href="#destacadas">Especialidades</a>
    <a href="#delivery">Delivery &amp; Pagos</a>
    <a href="#nosotros">Nuestra Masa</a>
  </nav>
</header>

<style>
  .header-canopy {
    box-shadow: 0 8px 22px rgb(49 7 12 / 0.38);
  }

  .header-canopy-image {
    position: absolute;
    top: calc(100% - 9.115rem);
    left: 50%;
    z-index: 0;
    width: 700px;
    max-width: none;
    height: auto;
    transform: translateX(-50%);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .header-canopy-image {
      top: calc(100% - max(20.833vw, 12.5rem));
      width: max(100%, 960px);
    }
  }

  .header-canopy::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgb(50 7 12 / 0.18),
      transparent 35%,
      rgb(50 7 12 / 0.16)
    );
    pointer-events: none;
  }
</style>
