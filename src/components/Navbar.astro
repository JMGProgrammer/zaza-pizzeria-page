---
import headerBg from "../../Assets/header-reworked-zaza.png";
import { whatsappLink } from "../data/businessInfo";
---

<!-- El asset ya trae la marca centrada y el festón transparente. El hero pasa por
     detrás del toldo en desktop para que el borde conserve sus huecos reales. -->
<header class="header sticky top-0 z-40 isolate text-zaza-cream-100">
  <div
    class="toldo-fondo"
    style={`--toldo-img: url(${headerBg.src});`}
    aria-hidden="true"
  ></div>
  <a
    class="brand-link"
    href="#inicio"
    aria-label="ZAZA Pizzería · Volver al inicio"
  ></a>
  <div class="header-actions mx-auto max-w-6xl px-6">
    <a
      class="button order-link hidden border border-zaza-cream-300/60 text-sm hover:bg-zaza-wine-700 lg:inline-flex"
      href={whatsappLink()}
      target="_blank"
      rel="noopener noreferrer"
    >
      Hacer pedido ↗
    </a>
  </div>
</header>

<style>
  .header {
    height: 150px;
  }
  .toldo-fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--toldo-img);
    background-repeat: no-repeat;
    /* Móvil: mantener la marca centrada y legible, sin repetirla ni estirar los pliegues. */
    background-size: auto 150px;
    background-position: center bottom;
  }
  .brand-link {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 50%;
    width: 140px;
    height: 75px;
    transform: translateX(-50%);
  }
  .brand-link:focus-visible {
    outline: 3px solid var(--color-zaza-cream-100);
    outline-offset: -4px;
  }
  .header-actions {
    position: absolute;
    inset: auto 0 27px;
    height: 36px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .order-link {
    position: absolute;
    right: 8rem;
  }
  @media (min-width: 768px) {
    .header {
      height: min(200px, 20.57vw);
    }
    .toldo-fondo {
      background-size: 100% 100%;
    }
    .brand-link {
      width: clamp(150px, 24vw, 270px);
      height: 50%;
    }
    .header-actions {
      bottom: 24%;
    }
  }
</style>
