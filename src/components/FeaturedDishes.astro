---
// Platillos destacados disponibles para una futura iteración; no se montan por ahora.
import { menuItems } from "../data/menu";
import PizzaCard from "./PizzaCard.astro";
---

<section
  id="destacadas"
  class="deferred-section bg-zaza-cream-100 px-6 py-16 md:py-24"
>
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow text-zaza-wine-700">De nuestra cocina</p>
    <h2 class="mt-3 text-4xl text-zaza-wine-800 md:text-5xl">
      La pizza tiene su momento.
    </h2>
    <p class="mt-4 text-zaza-muted">
      Elegí tu favorita. Del resto, hablamos por WhatsApp.
    </p>
    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {menuItems
        .filter((item) => item.image)
        .map((item) => (
          <PizzaCard item={item} />
        ))}
    </div>
  </div>
</section>
